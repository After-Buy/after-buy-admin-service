# Database Settings (AWS RDS MySQL - admin_db)
DB_HOST=your_rds_host
DB_PORT=3306
DB_NAME=admin_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_secret_password

# MSA Internal Auth Header Secret (서버 간 내부망 통신 보안 암호 - 통계 취합용)
INTERNAL_SECRET_KEY=your_msa_shared_internal_secret_key
JWT_SECRET=your_super_secret_jwt_signature_key_for_auth_service

# 관리자 웹사이트 프론트엔드 URL (CORS 및 리다이렉트 허용용)
ADMIN_FRONTEND_URL=http://localhost:5173

# MSA 내부 서비스 통신 URL (개발 서버용 - 경로 기반 라우팅)
DEVICE_SERVICE_URL=https://dev.after-buy.r-e.kr/api/devices
NOTIFICATION_SERVICE_URL=https://dev.after-buy.r-e.kr/api/notifications
AUTH_SERVICE_URL=https://dev.after-buy.r-e.kr/api/auth

# CORS 허용 Origin
CORS_ALLOWED_ORIGINS=https://after-buy-admin.vercel.app